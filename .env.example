DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
MONITOR_TOKEN=replace-with-a-long-random-token
CRON_SECRET=replace-with-another-long-random-token
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-different-long-random-token
INTEGRATION_HEALTH_TOKEN=64-random-hex-characters-used-as-ed25519-signing-seed
